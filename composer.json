{
    "name": "bulton-fr/bfw",
    "type": "library",
    "description": "Framework PHP",
    "keywords": [
        "framework",
        "php"
    ],
    "homepage": "https://github.com/bfw-systems/bfw",
    "time": "2016-05-29",
    "license": "LGPL-3.0-only",
    "authors": [
        {
            "name": "Vermeulen Maxime / Bulton",
            "homepage": "http://www.bulton.fr",
            "email": "bulton.fr@gmail.com"
        }
    ],
    "support": {
        "email": "support@bulton.fr",
        "issues": "https://github.com/bfw-systems/bfw/issues",
        "source": "https://github.com/bfw-systems/bfw"
    },
    "require": {
        "php": "^7.2.0 || ^8.0",
        "bulton-fr/dependency-tree": "^1.2",
        "monolog/monolog": "^1.0 || ^2.0 || ^3.0",
        "bulton-fr/utils": "~1.0 || ^2.0"
    },
    "require-dev": {
        "atoum/atoum": "^3.1 || ^4.0",
        "atoum/visibility-extension": "^1.3 || ^2.0",
        "pulse00/monolog-parser": "^0.0.3",
        "squizlabs/php_codesniffer": "^3.7 || ^4.0",
        "phpstan/phpstan": "^1.10",
        "phpmd/phpmd": "^2.13",
        "vimeo/psalm": "^5.0"
    },
    "suggest": {
        "ext-memcached": "To save datas into your memory and be faster to access it",
        "bulton-fr/bfw-api": "API module for the framework",
        "bulton-fr/bfw-controller": "Controller module for the framework",
        "bulton-fr/bfw-fastroute": "Router module for the framework who use fastroute lib",
        "bulton-fr/bfw-fenom": "Template module for the framework who use fenom",
        "bulton-fr/bfw-sql": "Queries systems module for the framework"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "BFW\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BFW\\Test\\Bin\\": "test/bin",
            "BFW\\Test\\Mock\\": "test/unit/mocks/src",
            "BFW\\Test\\Helpers\\": "test/unit/helpers"
        }
    },
    "bin": [
        "bin/bfwInstall",
        "bin/bfwAddMod",
        "bin/bfwDelMod",
        "bin/bfwDisMod",
        "bin/bfwEnMod"
    ],
    "scripts": {
        "test": "atoum -c .atoum.php -d test/unit/src +verbose",
        "test-ci": [
            "@test",
            "php ./test/bin/installFwk.php",
            "php ./test/bin/moduleManager.php"
        ],
        "cs-check": "phpcs --standard=phpcs.xml.dist src/",
        "cs-fix": "phpcbf --standard=phpcs.xml.dist src/",
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist",
        "psalm": "psalm --config=psalm.xml.dist",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@psalm"
        ],
        "ci": [
            "@test-ci",
            "@quality"
        ]
    }
}
