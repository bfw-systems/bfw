<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="BFW" xsi:noNamespaceSchemaLocation="phpcs.xsd">
    <description>BFW Coding Standard (PSR-12)</description>

    <!-- Apply PSR-12 standard -->
    <rule ref="PSR12"/>

    <!-- Include source and test directories -->
    <file>src</file>
    <file>test</file>

    <!-- Exclude vendor directory -->
    <exclude-pattern>vendor/*</exclude-pattern>
    
    <!-- Show progress -->
    <arg value="p"/>

    <!-- Use colors -->
    <arg name="colors"/>

    <!-- Show sniff codes in all reports -->
    <arg value="s"/>
</ruleset>