<?xml version="1.0"?>
<psalm
    errorLevel="6"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
            <directory name="test" />
            <directory name="src/PrivateBinaries" />
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <!-- Allow mixed types for legacy compatibility -->
        <MixedReturnStatement errorLevel="info" />
        <MixedAssignment errorLevel="info" />
        <MixedArrayAccess errorLevel="info" />
        
        <!-- Allow undefined properties for dynamic configurations -->
        <UndefinedPropertyFetch errorLevel="info" />
        <UndefinedPropertyAssignment errorLevel="info" />
        
        <!-- Allow variable variables -->
        <ForbiddenCode errorLevel="suppress" />
    </issueHandlers>
</psalm>